---
import { withBase } from '../lib/url';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<img
  class:list={['brand-logo', className]}
  src={withBase('/brand/logo-horizontal-transparent.png')}
  width="1386"
  height="418"
  alt=""
  aria-hidden="true"
  draggable="false"
  decoding="async"
/>

<style>
  .brand-logo {
    display: block;
    width: 190px;
    height: auto;
    user-select: none;
  }

  @media (max-width: 480px) {
    .brand-logo {
      width: 168px;
    }
  }
</style>

---
import BrandMark from './BrandMark.astro';
import { event, navigation } from '../config/event';
import { withBase } from '../lib/url';
---

<footer class="site-footer" aria-labelledby="footer-title">
  <div class="site-footer__inner container">
    <div class="footer-top">
      <div class="footer-brand">
        <BrandMark class="footer-brand__mark" />
        <div>
          <p class="footer-brand__name" id="footer-title">合肥<span class="event-name-accent">「第一」</span>音游祭</p>
          <p class="footer-brand__en mono">{event.englishName} / {event.edition}</p>
        </div>
      </div>

      <p class="footer-statement">
        一场发生在合肥的音游现场。<br />
        比赛章程 v3.4 已发布，<br />
        场馆与现场时刻待公布。
      </p>

      <div class="footer-links">
        <nav class="footer-nav" aria-label="页脚导航">
          <p class="footer-label mono">EXPLORE</p>
          <ul role="list">
            <li><a href={withBase('/')}>首页 <span aria-hidden="true">↗</span></a></li>
            {
              navigation.map((item) => (
                <li>
                  <a href={withBase(item.href)}>
                    {item.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="footer-contact">
          <p class="footer-label mono">CONTACT</p>
          <p class="footer-contact__name">{event.organizer.name}</p>
          <p class="footer-contact__contact">{event.organizer.contact}</p>
        </div>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <span>HEFEI</span>
      <span class="footer-wordmark__outline">OTOGE FES</span>
    </div>

    <div class="footer-bottom">
      <p class="mono">© {event.edition} {event.englishName} / {event.eventCode}</p>
      <p class="footer-bottom__note">赛事信息以主办方最终公告为准 · 本页不含报名与成绩提交功能</p>
      <a class="footer-bottom__top mono" href="#top">
        返回顶部 <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--ink-line);
    background: var(--ink);
    color: var(--paper);
  }

  .site-footer::before {
    position: absolute;
    top: 0;
    left: var(--gutter);
    width: 4.5rem;
    height: 3px;
    background: var(--signal);
    content: "";
  }

  .site-footer__inner {
    padding-top: clamp(3.5rem, 7vw, 6.5rem);
    padding-bottom: 1.25rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1.15fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .footer-brand__mark {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--paper);
  }

  .footer-brand__name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .footer-brand__en {
    margin-top: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.62rem;
  }

  .footer-statement {
    padding-top: 0.3rem;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.25rem);
    line-height: 1.8;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 2rem;
  }

  .footer-label {
    margin-bottom: 1rem;
    color: var(--ink-muted);
    font-size: 0.58rem;
  }

  .footer-nav ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
  }

  .footer-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--paper);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-snap);
  }

  .footer-nav a span {
    color: var(--ink-muted);
    font-size: 0.8rem;
    transition: transform var(--dur-fast) var(--ease-snap);
  }

  .footer-nav a:hover {
    color: var(--signal);
  }

  .footer-nav a:hover span {
    transform: translate(0.15rem, -0.15rem);
  }

  .footer-contact__name {
    color: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .footer-contact__contact {
    margin-top: 0.25rem;
    color: var(--signal);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .footer-wordmark {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    margin-top: clamp(4rem, 9vw, 8rem);
    font-family: var(--font-latin);
    font-size: clamp(3.8rem, 13.5vw, 14rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.76;
    white-space: nowrap;
  }

  .footer-wordmark__outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--paper);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.15rem;
    border-top: 1px solid var(--ink-line);
    color: var(--ink-muted);
  }

  .footer-bottom .mono {
    color: var(--ink-muted);
    font-size: 0.58rem;
  }

  .footer-bottom__note {
    max-width: 40rem;
    font-size: var(--text-2xs);
    line-height: 1.6;
  }

  .footer-bottom__top {
    color: var(--paper);
    font-size: 0.6rem;
    text-decoration: none;
  }

  .footer-bottom__top:hover {
    color: var(--signal);
  }

  @media (max-width: 980px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .footer-links {
      grid-column: 1 / -1;
      padding-top: 1.5rem;
      border-top: 1px solid var(--ink-line);
    }

    .footer-wordmark {
      flex-direction: column;
      white-space: normal;
    }
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-links {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .footer-wordmark {
      margin-top: 4rem;
      font-size: clamp(3.3rem, 20vw, 7rem);
      line-height: 0.82;
    }

    .footer-wordmark__outline {
      -webkit-text-stroke-width: 1px;
    }

    .footer-bottom {
      align-items: flex-start;
    }

    .footer-bottom__top {
      width: 100%;
      padding-top: 0.5rem;
    }
  }
</style>

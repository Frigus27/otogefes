---
import StatusBadge from './StatusBadge.astro';
import type { StatusTone } from '../config/event';

interface Props {
  index: string;
  kicker: string;
  title: string;
  englishTitle: string;
  description: string;
  status?: {
    label: string;
    tone: StatusTone;
  };
  accent?: 'signal' | 'flare' | 'sky' | 'violet';
}

const {
  index,
  kicker,
  title,
  englishTitle,
  description,
  status,
  accent = 'signal',
} = Astro.props;

const accentValue = {
  signal: 'var(--signal)',
  flare: 'var(--flare)',
  sky: 'var(--sky)',
  violet: 'var(--violet)',
}[accent];
---

<section class="page-hero" style={`--page-accent: ${accentValue};`} aria-labelledby="page-title">
  <div class="page-hero__inner container">
    <div class="page-hero__top">
      <p class="eyebrow">{kicker}</p>
      <p class="page-hero__code mono">PAGE {index} / HF-OTG-01</p>
    </div>

    <div class="page-hero__main">
      <div class="page-hero__title-wrap">
        <p class="page-hero__en latin">{englishTitle}</p>
        <h1 id="page-title">{title}</h1>
        <span class="page-hero__accent" aria-hidden="true"></span>
      </div>

      <div class="page-hero__aside">
        {status && <StatusBadge label={status.label} tone={status.tone} />}
        <p class="page-hero__description">{description}</p>
        <slot />
      </div>
    </div>
  </div>

  <span class="page-hero__index" aria-hidden="true">{index}</span>
  <div class="page-hero__grid" aria-hidden="true"></div>
</section>

<style>
  .page-hero {
    --fg: var(--paper);
    --fg-muted: var(--ink-muted);
    --border: var(--ink-line);
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--ink-line);
    background: var(--ink);
    color: var(--paper);
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
  }

  .page-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ink-line);
  }

  .page-hero__code {
    color: var(--ink-muted);
    font-size: 0.58rem;
    white-space: nowrap;
  }

  .page-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.7fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .page-hero__title-wrap {
    position: relative;
  }

  .page-hero__en {
    margin-bottom: 1.15rem;
    color: var(--page-accent);
    font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.85rem);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .page-hero h1 {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 1.6rem + 7vw, 8.4rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .page-hero__accent {
    display: block;
    width: clamp(4rem, 12vw, 10rem);
    height: 5px;
    margin-top: 1.5rem;
    background: var(--page-accent);
  }

  .page-hero__aside {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    padding-bottom: 0.35rem;
  }

  .page-hero__description {
    max-width: 34rem;
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .page-hero__index {
    position: absolute;
    z-index: 0;
    right: calc(var(--gutter) * 0.35);
    bottom: -0.23em;
    color: transparent;
    font-family: var(--font-latin);
    font-size: clamp(10rem, 27vw, 29rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.7;
    -webkit-text-stroke: 1px rgba(243, 240, 230, 0.11);
    pointer-events: none;
    user-select: none;
  }

  .page-hero__grid {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc(8.333% - 1px),
      rgba(243, 240, 230, 0.04) calc(8.333% - 1px),
      rgba(243, 240, 230, 0.04) 8.333%
    );
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .page-hero__main {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 2rem;
    }

    .page-hero__aside {
      max-width: 38rem;
    }

    .page-hero__index {
      right: -0.08em;
      bottom: -0.1em;
      font-size: clamp(8rem, 36vw, 18rem);
    }
  }

  @media (max-width: 560px) {
    .page-hero__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .page-hero__code {
      text-align: left;
    }

    .page-hero h1 {
      font-size: clamp(3rem, 16vw, 5rem);
    }
  }
</style>

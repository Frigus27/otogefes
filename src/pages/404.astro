---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="页面未找到" noindex={true}>
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="eyebrow">ERROR / 404</p>
      <div class="not-found__code" aria-hidden="true">404</div>
      <h1>这一拍，没有落点。</h1>
      <p>你访问的页面不存在，或赛程与公告内容已经移动。可以返回首页，或直接查看预选榜单与公告。</p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href={withBase('/')}>返回首页 <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--outline-light" href={withBase('/news')}>查看公告 <span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 70svh;
    place-items: center;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }

  .not-found__inner {
    position: relative;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .not-found__code {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: var(--gutter);
    transform: translateY(-50%);
    color: transparent;
    font-family: var(--font-latin);
    font-size: clamp(12rem, 32vw, 34rem);
    font-weight: 900;
    letter-spacing: -0.09em;
    line-height: 0.7;
    -webkit-text-stroke: 1px rgba(243, 240, 230, 0.12);
    pointer-events: none;
  }

  .not-found__inner > *:not(.not-found__code) {
    position: relative;
    z-index: 1;
  }

  .not-found h1 {
    max-width: 12ch;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 6vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .not-found p:not(.eyebrow) {
    max-width: 32rem;
    margin-top: 1.2rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  @media (max-width: 560px) {
    .not-found__actions .btn {
      width: 100%;
    }
  }
</style>

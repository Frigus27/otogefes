---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { event } from '../config/event';
import { ranking } from '../data/ranking';
import { schedule } from '../data/schedule';
import { validateScheduleData } from '../lib/validate';
import { RANKING_ENDPOINT } from '../config/ranking';
import { formatDate, formatDateTime, formatScore, padNumber } from '../lib/format';
import { withBase } from '../lib/url';

validateScheduleData(schedule);

const news = (await getCollection('news')).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const featuredNews = news.find((post) => post.data.pinned) ?? news[0];
const secondaryNews = news.filter((post) => post.id !== featuredNews?.id).slice(0, 3);
const featuredTitle = featuredNews?.data.title ?? '';
const featuredTitleParts = featuredTitle.split('：');
const featuredTitleBreak =
  featuredTitleParts.length > 1 &&
  featuredTitleParts[0].length >= 4 &&
  featuredTitleParts.slice(1).join('：').length >= 4;
const topEntries = ranking.entries.slice(0, 3);

const tickerItems = [
  `PROJECT / ${event.project.name}`,
  'FORMAT / LCQ + 八强双败',
  `DATE / ${event.dates.display}`,
  `VENUE / ${event.venue.city}`,
  'RULES / CHARTER V3.4',
  `STATUS / ${event.status.label} · ${event.status.rangeShort}`,
];
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__decor" aria-hidden="true">
      <span class="home-hero__decor-index">#01</span>
      <span class="home-hero__decor-line"></span>
    </div>

    <div class="container home-hero__inner">
      <div class="home-hero__top">
        <p class="eyebrow">HEFEI OTOGE FES / VOL. 01</p>
        <div class="home-hero__top-meta">
          <span class="mono">HF-OTG-01</span>
          <span class="home-hero__status">
            <i aria-hidden="true"></i>
            {event.status.phase}
          </span>
        </div>
      </div>

      <h1 id="home-title" class="home-hero__title" aria-label={event.name}>
        <span class="home-hero__city">
          合肥
          <span class="home-hero__city-en latin">HEFEI, ANHUI</span>
          <span class="home-hero__city-line" aria-hidden="true"></span>
        </span>
        <span class="home-hero__first-line">「第一」</span>
        <span class="home-hero__last-line">音游祭</span>
      </h1>

      <div class="home-hero__body">
        <div class="home-hero__copy">
          <p class="home-hero__tagline">{event.tagline}</p>
          <p class="home-hero__intro">{event.summary}</p>

          <div class="home-hero__actions">
            <a class="btn btn--primary" href={withBase('/ranking')}>
              查看预选榜单
              <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="btn btn--outline-light" href={withBase('/rules')}>
              阅读比赛章程
              <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <dl class="home-hero__meta">
            <div>
              <dt class="mono">GAME / 比赛项目</dt>
              <dd>{event.project.name}</dd>
            </div>
            <div>
              <dt class="mono">DATE / 日期</dt>
              <dd>{event.dates.display}</dd>
            </div>
            <div>
              <dt class="mono">VENUE / 地点</dt>
              <dd>{event.venue.display}</dd>
            </div>
            <div>
              <dt class="mono">FORMAT / 形式</dt>
              <dd>{event.format.display}</dd>
            </div>
          </dl>
        </div>

        <div class="home-hero__visual">
          <aside class="hero-news" aria-labelledby="hero-news-title">
            <div class="hero-news__head">
              <h2 id="hero-news-title" class="hero-news__title">
                <span class="mono">LATEST NEWS</span>
                <span>赛事公告</span>
              </h2>
              <span class="hero-news__count mono">{padNumber(news.length)} UPDATES</span>
            </div>

            {
              featuredNews ? (
                <article class="hero-news__featured">
                  <div class="hero-news__meta mono">
                    <span class="hero-news__pin">
                      {featuredNews.data.pinned ? 'PINNED / 置顶' : 'FEATURED / 精选'}
                    </span>
                    <time datetime={featuredNews.data.pubDate.toISOString()}>
                      {formatDate(featuredNews.data.pubDate)}
                    </time>
                    <span>{featuredNews.data.category}</span>
                  </div>
                  <h3>
                    <a href={withBase(`/news/${featuredNews.id}`)}>
                      {featuredTitleBreak ? (
                        <>
                          {featuredTitleParts[0]}：<br />
                          {featuredTitleParts.slice(1).join('：')}
                        </>
                      ) : (
                        featuredNews.data.title
                      )}
                    </a>
                  </h3>
                  <p>{featuredNews.data.description}</p>
                  <a class="hero-news__read" href={withBase(`/news/${featuredNews.id}`)}>
                    阅读全文
                    <span aria-hidden="true">→</span>
                  </a>
                </article>

                <ul class="hero-news__list" role="list">
                  {secondaryNews.map((post) => (
                    <li>
                      <a class="hero-news__row" href={withBase(`/news/${post.id}`)}>
                        <span class="hero-news__row-meta">
                          <time class="mono" datetime={post.data.pubDate.toISOString()}>
                            {formatDate(post.data.pubDate)}
                          </time>
                          <span class="hero-news__row-cat">{post.data.category}</span>
                        </span>
                        <span class="hero-news__row-title">{post.data.title}</span>
                        <span class="hero-news__row-arrow" aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="hero-news__empty">
                  当前还没有公告。新增 Markdown 文件后，这里会自动生成列表与详情页。
                </p>
              )
            }

            <a class="hero-news__all" href={withBase('/news')}>
              <span class="hero-news__all-label">
                全部公告
                <span class="mono">ALL POSTS</span>
              </span>
              <span class="hero-news__all-arrow" aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </div>
    </div>

    <div class="container home-hero__foot">
      <span class="mono">SCROLL TO EXPLORE</span>
      <span class="home-hero__foot-line" aria-hidden="true"></span>
      <span class="mono">RHYTHM / PRECISION / LIVE</span>
    </div>
  </section>

  <div class="ticker" role="region" aria-label="赛事信息">
    <div class="ticker__track">
      {
        [0, 1].map((copy) => (
          <div class="ticker__group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {tickerItems.map((item) => (
              <span class="ticker__item">
                {item}
                <span class="ticker__slash" aria-hidden="true">
                  /
                </span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section class="home-flow section section--paper-deep" aria-labelledby="flow-title">
    <div class="container">
      <div class="flow-grid">
        <div class="flow-lead" data-reveal>
          <p class="eyebrow">01 / COMPETITION FLOW</p>
          <h2 id="flow-title">
            赛事流程
          </h2>
          <p class="flow-lead__note mono">FOUR STAGES / ONLINE → LCQ → LIVE</p>
        </div>

        <div class="flow-copy" data-reveal style="--reveal-delay: 100ms;">
          <p class="flow-copy__lead">
            线上<span class="event-name-accent event-name-accent--light">预选</span>，决出八强；现场双败，决出冠军。
          </p>
          <p>
            预选于 11 月 15 日至 12 月 15 日进行，前七名直接晋级正赛，第 8—15 名进入线下 LCQ，争夺最后一个正赛名额。
          </p>
          <p class="flow-copy__note">
            线下比赛拟于 2027 年 1 月 1 日举行。八强正赛采用双败赛制与九时段双舞台排程；场馆与具体时刻待公布。
          </p>
          <a class="link-arrow" href={withBase('/rules')}>
            阅读比赛章程
            <span class="link-arrow__icon" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <ol class="flow-strip" role="list">
        {
          event.stages.map((stage, index) => (
            <li
              class:list={['flow-stage', { 'is-active': stage.tone === 'active' }]}
              data-reveal
              style={`--reveal-delay: ${index * 70}ms;`}
            >
              <div class="flow-stage__top">
                <span class="flow-stage__code latin">{stage.code}</span>
                <StatusBadge label={stage.status} tone={stage.tone} />
              </div>
              <h3>{stage.title}</h3>
              <p>{stage.summary}</p>
            </li>
          ))
        }
      </ol>

      <div class="flow-foot" data-reveal>
        <p class="flow-foot__note mono">STATUS TRACKS THE PREPARATION / 以最终公告为准</p>
        <a class="btn btn--cream" href={withBase('/schedule')}>
          查看现场赛程
          <span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-ranking section" aria-labelledby="ranking-preview-title">
    <div class="container">
      <div class="ranking-preview">
        <div class="ranking-preview__copy" data-reveal>
          <p class="eyebrow">02 / QUALIFIER RANKING</p>
          <h2 id="ranking-preview-title">预选榜单</h2>
          <p class="ranking-preview__lead">
            线上预选期间，这里记录有效成绩与审核状态。第 1—7 名直通正赛，第 8—15 名进入 LCQ。
          </p>
          <div class="ranking-preview__tags">
            <span data-home-status><StatusBadge label={ranking.statusLabel} tone={ranking.statusTone} /></span>
            <span class="tag tag--cream" data-home-mode-tag>LIVE DATA</span>
          </div>
          <p class="notice" data-home-notice>{ranking.notice}</p>
          <a class="btn btn--cream" href={withBase('/ranking')}>
            查看完整榜单
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div
          class="mini-ranking"
          data-reveal
          data-home-ranking
          data-ranking-endpoint={RANKING_ENDPOINT}
          data-ranking-version={ranking.updatedAt}
          style="--reveal-delay: 120ms;"
        >
          <div class="mini-ranking__head">
            <span class="mono">TOP 03 / PREVIEW</span>
            <span class="mono" data-home-updated>UPDATED {formatDateTime(new Date(ranking.updatedAt))}</span>
          </div>
          <ol role="list" data-home-ranking-list>
            {
              topEntries.map((entry) => (
                <li class="mini-ranking__row" data-home-ranking-row>
                  <span class="mini-ranking__rank latin" data-home-rank>{padNumber(entry.rank)}</span>
                  <span class="mini-ranking__player">
                    <span class="mini-ranking__name" data-home-name>{entry.playerName}</span>
                    <span class="mini-ranking__id" data-home-id>{entry.playerId}</span>
                    {entry.videoUrl && (
                      <a
                        class="mini-ranking__video"
                        data-home-video
                        href={entry.videoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`查看 ${entry.playerName} 的手元或屏元`}
                      >
                        手元或屏元 ↗
                      </a>
                    )}
                  </span>
                  <span class="mini-ranking__scores" data-home-scores aria-label={`${entry.playerName} 的总分与三曲成绩`}>
                    {entry.scores.map((score, scoreIndex) => (
                      <span class="mini-ranking__score-line">
                        <span class="mini-ranking__score-label">S{scoreIndex + 1}</span>
                        <span class="mini-ranking__score" data-home-score={scoreIndex}>{formatScore(score)}</span>
                      </span>
                    ))}
                    <span class="mini-ranking__score-line mini-ranking__score-line--total">
                      <span class="mini-ranking__score-label">TOTAL</span>
                      <span class="mini-ranking__total" data-home-total>{formatScore(entry.total)}</span>
                    </span>
                  </span>
                </li>
              ))
            }
          </ol>
          <div class="mini-ranking__foot">
            <span class="mono" data-home-entries-label>LIVE ENTRIES / 实时数据</span>
            <span class="mini-ranking__cut" data-home-cut>直通线 / TOP {padNumber(ranking.cutoff)} · LCQ {padNumber(ranking.lcqCutoff)}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-schedule section section--paper-deep" aria-labelledby="schedule-preview-title">
    <div class="container">
      <div class="schedule-preview">
        <div class="schedule-preview__lead" data-reveal>
          <p class="eyebrow">03 / LIVE SCHEDULE</p>
          <h2 id="schedule-preview-title">现场见。</h2>
          <p>
            线上预选结束后，晋级选手将在合肥进入 LCQ 与八强双败正赛。比赛日拟为 2027 年 1 月 1 日，场馆与具体时刻待公布。
          </p>
          <div class="schedule-date">
            <span class="schedule-date__label mono">DATE / 日期</span>
            <strong class="schedule-date__value latin">27.1.1</strong>
            <span class="schedule-date__cn">{event.dates.note}（拟）</span>
            <span class="schedule-date__venue">{schedule.venueName} · {event.venue.city}</span>
          </div>
          <a class="link-arrow" href={withBase('/schedule')}>
            查看赛程页
            <span class="link-arrow__icon" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="schedule-preview__list" data-reveal style="--reveal-delay: 100ms;">
          <div class="schedule-preview__head">
            <span class="mono">ON-SITE RUN OF SHOW / 比赛日</span>
            <span class="mono">{schedule.items.length} STAGES</span>
          </div>
          <ol role="list">
            {
              schedule.items.slice(0, 4).map((item) => (
                <li class="schedule-preview__row">
                  <span class="schedule-preview__code mono">{item.code}</span>
                  <span class="schedule-preview__title">{item.title}</span>
                  <span class="schedule-preview__time mono">{item.time}</span>
                  <span class="schedule-preview__arrow" aria-hidden="true">↗</span>
                </li>
              ))
            }
          </ol>
          <p class="schedule-preview__note">{schedule.notice}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================
     Hero
     ========================================================= */

  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - var(--header-height));
    padding-top: clamp(1.4rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--ink-line);
    background: var(--ink);
    color: var(--paper);
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc(8.333% - 1px),
      rgba(243, 240, 230, 0.045) calc(8.333% - 1px),
      rgba(243, 240, 230, 0.045) 8.333%
    );
    content: "";
    pointer-events: none;
  }

  .home-hero::after {
    position: absolute;
    top: 0;
    left: var(--gutter);
    width: clamp(3.5rem, 8vw, 7rem);
    height: 4px;
    background: var(--flare);
    content: "";
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height) - 4.2rem);
  }

  .home-hero__decor {
    position: absolute;
    top: 5rem;
    right: calc(var(--gutter) * 0.75);
    z-index: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: rgba(243, 240, 230, 0.16);
    pointer-events: none;
  }

  .home-hero__decor-index {
    font-family: var(--font-latin);
    font-size: clamp(7rem, 19vw, 19rem);
    font-weight: 900;
    letter-spacing: -0.09em;
    line-height: 0.7;
  }

  .home-hero__decor-line {
    width: 1px;
    height: 12rem;
    background: currentColor;
  }

  .home-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--ink-line);
  }

  .home-hero__top .eyebrow {
    color: var(--ink-muted);
  }

  .home-hero__top-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: var(--ink-muted);
  }

  .home-hero__top-meta .mono {
    font-size: 0.57rem;
  }

  .home-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
  }

  .home-hero__status i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: currentColor;
    animation: blink 2.6s steps(2, jump-none) infinite;
  }

  .home-hero__title {
    position: relative;
    z-index: 1;
    padding-top: clamp(1.15rem, 2.6vw, 2rem);
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
  }

  .home-hero__city {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-left: 0.08em;
    color: var(--paper);
    font-size: clamp(2.4rem, 5vw, 5rem);
    letter-spacing: 0.08em;
    line-height: 1.05;
  }

  .home-hero__city-en {
    color: var(--ink-muted);
    font-size: clamp(0.54rem, 0.7vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .home-hero__city-line {
    flex: 1;
    height: 1px;
    margin-left: 0.5rem;
    background: var(--ink-line);
  }

  .home-hero__first-line {
    display: block;
    width: max-content;
    margin-top: clamp(1.25rem, 2.6vw, 2.5rem);
    margin-left: 0;
    color: var(--signal);
    text-indent: -0.22em;
    font-size: clamp(5rem, 15.5vw, 15rem);
    letter-spacing: -0.09em;
    line-height: 0.84;
    white-space: nowrap;
  }

  .home-hero__last-line {
    display: block;
    position: relative;
    width: max-content;
    margin-top: clamp(1.75rem, 3.2vw, 3rem);
    margin-left: 0;
    color: var(--paper);
    font-size: clamp(3rem, 12.5vw, 12rem);
    letter-spacing: -0.09em;
    line-height: 0.84;
    white-space: nowrap;
  }

  .home-hero__body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.95fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
    padding-top: clamp(1.4rem, 3vw, 2.6rem);
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0.3rem;
    padding-bottom: 0.5rem;
  }

  .home-hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.85vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .home-hero__intro {
    max-width: 37rem;
    margin-top: 0.8rem;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.4rem;
  }

  .home-hero__meta {
    display: grid;
    grid-template-columns:
      minmax(0, 0.58fr) minmax(0, 0.86fr) minmax(0, 1.04fr)
      minmax(0, 1.52fr);
    width: 100%;
    max-width: 48rem;
    margin-top: 1.8rem;
    border-top: 1px solid var(--ink-line);
  }

  .home-hero__meta > div {
    min-width: 0;
    padding: 0.75rem 1rem 0 0;
  }

  .home-hero__meta > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--ink-line);
  }

  .home-hero__meta dt {
    color: var(--ink-muted);
    font-size: 0.5rem;
  }

  .home-hero__meta dd {
    margin: 0.25rem 0 0;
    color: var(--paper);
    font-size: 0.8rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .home-hero__visual {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    align-self: start;
    margin-top: clamp(-7rem, -6vw, -1.5rem);
    margin-bottom: 1rem;
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero-news {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 34rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 12px 12px 0 var(--cream-deep);
  }

  .hero-news__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding: 0.8rem 1.15rem;
    background: var(--cream);
  }

  .hero-news__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .hero-news__title .mono {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .hero-news__count {
    color: rgba(23, 24, 17, 0.68);
    font-size: 0.48rem;
    letter-spacing: 0.09em;
  }

  .hero-news__featured {
    padding: 1.15rem 1.15rem 1.2rem;
    border-bottom: 1px solid var(--ink);
  }

  .hero-news__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    color: var(--paper-muted);
    font-size: 0.49rem;
    letter-spacing: 0.05em;
  }

  .hero-news__pin {
    padding: 0.15rem 0.4rem;
    background: var(--cream-deep);
    color: var(--ink);
    font-size: 0.47rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }

  .hero-news__featured h3 {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.75vw, 1.85rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.28;
    text-wrap: balance;
  }

  .hero-news__featured h3 a {
    text-decoration: none;
  }

  .hero-news__featured h3 a:hover {
    background: var(--cream);
    outline: 0.14em solid var(--cream);
  }

  .hero-news__featured > p {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0.55rem;
    color: var(--paper-muted);
    font-size: 0.78rem;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .hero-news__read {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.85rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.9;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero-news__read span {
    transition: transform var(--dur-fast) var(--ease-snap);
  }

  .hero-news__read:hover span {
    transform: translateX(0.28rem);
  }

  .hero-news__list {
    list-style: none;
  }

  .hero-news__list li + li {
    border-top: 1px solid var(--paper-line);
  }

  .hero-news__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 1.1rem;
    gap: 0.85rem;
    align-items: center;
    padding: 0.68rem 1.15rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-snap);
  }

  .hero-news__row:hover {
    background: var(--paper-raised);
  }

  .hero-news__row-meta {
    display: grid;
    gap: 0.1rem;
  }

  .hero-news__row-meta time {
    color: var(--paper-muted);
    font-size: 0.47rem;
    letter-spacing: 0.03em;
  }

  .hero-news__row-cat {
    color: var(--flare-text);
    font-family: var(--font-mono);
    font-size: 0.43rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-news__row-title {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .hero-news__row:hover .hero-news__row-title {
    text-decoration: underline;
    text-decoration-color: var(--apricot);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .hero-news__row-arrow {
    justify-self: end;
    color: var(--paper-muted);
    font-size: 0.95rem;
    transition:
      color var(--dur-fast) var(--ease-snap),
      transform var(--dur-fast) var(--ease-snap);
  }

  .hero-news__row:hover .hero-news__row-arrow {
    color: var(--ink);
    transform: translate(0.12rem, -0.12rem);
  }

  .hero-news__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-top: 1px solid var(--ink);
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-snap),
      color var(--dur-fast) var(--ease-snap);
  }

  .hero-news__all-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .hero-news__all-label .mono {
    color: var(--paper-muted);
    font-size: 0.47rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: color var(--dur-fast) var(--ease-snap);
  }

  .hero-news__all-arrow {
    color: var(--paper-muted);
    font-size: 1rem;
    transition:
      color var(--dur-fast) var(--ease-snap),
      transform var(--dur-fast) var(--ease-snap);
  }

  .hero-news__all:hover {
    background: var(--cream-deep);
    color: var(--ink);
  }

  .hero-news__all:hover .hero-news__all-label .mono {
    color: var(--paper-muted);
  }

  .hero-news__all:hover .hero-news__all-arrow {
    color: var(--ink);
    transform: translate(0.18rem, -0.18rem);
  }

  .hero-news__empty {
    padding: 1.3rem 1.15rem;
    color: var(--paper-muted);
    font-size: 0.8rem;
    line-height: 1.75;
  }

  .home-hero__foot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.3rem;
    padding-bottom: 1.1rem;
    color: var(--ink-muted);
  }

  .home-hero__foot .mono {
    font-size: 0.5rem;
  }

  .home-hero__foot-line {
    flex: 1;
    height: 1px;
    background: var(--ink-line);
  }

  /* =========================================================
     Ticker
     ========================================================= */

  .ticker {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--ink);
    background: var(--cream);
    color: var(--ink);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .ticker:hover .ticker__track,
  .ticker:focus-within .ticker__track {
    animation-play-state: paused;
  }

  .ticker__group {
    display: flex;
    flex: none;
    align-items: center;
    padding-block: 0.72rem;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    padding-inline: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    white-space: nowrap;
  }

  .ticker__slash {
    color: rgba(23, 24, 17, 0.38);
    font-size: 0.85rem;
  }

  /* =========================================================
     Flow
     ========================================================= */

  .flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 8vw, 9rem);
    align-items: start;
  }

  .flow-lead h2 {
    margin-top: 1.8rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.6rem + 5vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .flow-lead__note {
    margin-top: 2rem;
    color: var(--paper-muted);
    font-size: 0.55rem;
  }

  .flow-copy {
    padding-top: clamp(2rem, 6vw, 5.2rem);
  }

  .flow-copy__lead {
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--paper-line);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.65;
  }

  .flow-copy p:not(.flow-copy__lead):not(.flow-copy__note) {
    margin-top: 1.2rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.9;
  }

  .flow-copy__note {
    margin-top: 1.1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--flare);
    color: var(--paper-muted);
    font-size: var(--text-xs);
    line-height: 1.8;
  }

  .flow-copy .link-arrow {
    margin-top: 1.8rem;
  }

  .flow-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    list-style: none;
  }

  .flow-stage {
    position: relative;
    min-width: 0;
    padding: 1.2rem clamp(0.85rem, 2vw, 1.6rem) 1.5rem;
  }

  .flow-stage + .flow-stage {
    border-left: 1px solid var(--paper-line);
  }

  .flow-stage.is-active {
    border-left-color: var(--ink);
    background: var(--cream);
  }

  .flow-stage.is-active + .flow-stage {
    border-left-color: var(--ink);
  }

  .flow-stage__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .flow-stage__code {
    color: var(--paper-muted);
    font-size: clamp(1.9rem, 3vw, 2.9rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .flow-stage.is-active .flow-stage__code {
    color: var(--ink);
  }

  .flow-stage .status {
    padding: 0.22rem 0.48rem;
  }

  .flow-stage.is-active .status {
    --status-color: var(--ink);
    border-color: rgba(23, 24, 17, 0.38);
  }

  .flow-stage h3 {
    margin-top: 1.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.55vw, 1.65rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .flow-stage p {
    margin-top: 0.6rem;
    color: var(--paper-muted);
    font-size: 0.76rem;
    line-height: 1.75;
  }

  .flow-stage.is-active p {
    color: var(--paper-muted);
  }

  .flow-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .flow-foot__note {
    color: var(--paper-muted);
    font-size: 0.53rem;
    letter-spacing: 0.05em;
  }

  /* =========================================================
     Ranking preview
     ========================================================= */

  .ranking-preview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .ranking-preview__copy h2 {
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.7rem + 4vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .ranking-preview__lead {
    max-width: 33rem;
    margin-top: 1.2rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .ranking-preview__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .ranking-preview .notice {
    max-width: 34rem;
    margin-top: 1.2rem;
  }

  .ranking-preview .btn {
    margin-top: 1.5rem;
  }

  .mini-ranking {
    border: 1px solid var(--ink);
    background: var(--cream-soft);
    color: var(--ink);
    box-shadow: 10px 10px 0 var(--cream-deep);
  }

  .mini-ranking__head,
  .mini-ranking__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    color: var(--paper-muted);
  }

  .mini-ranking__head {
    border-bottom: 1px solid var(--paper-line);
  }

  .mini-ranking__head .mono,
  .mini-ranking__foot .mono {
    font-size: 0.48rem;
  }

  .mini-ranking ol {
    list-style: none;
  }

  .mini-ranking__row {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: start;
    padding: 1.15rem 1rem;
    border-bottom: 1px solid var(--paper-line);
  }

  .mini-ranking__row:last-child {
    border-bottom: 0;
  }

  .mini-ranking__rank {
    color: var(--signal-text);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .mini-ranking__player {
    display: grid;
    gap: 0.08rem;
    align-content: center;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    letter-spacing: 0.02em;
  }

  .mini-ranking__name {
    display: block;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .mini-ranking__id {
    display: block;
    color: var(--paper-muted);
    font-size: 0.54rem;
    line-height: 1.35;
  }

  .mini-ranking__video {
    width: max-content;
    color: var(--sky-text);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .mini-ranking__video:hover {
    color: var(--flare-text);
  }

  .mini-ranking__scores {
    display: grid;
    gap: 0.1rem;
    justify-items: end;
  }

  .mini-ranking__score-line {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .mini-ranking__score-label {
    color: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: 0.45rem;
  }

  .mini-ranking__score {
    font-family: var(--font-latin);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mini-ranking__score-line--total {
    margin-top: 0.12rem;
    padding-top: 0.18rem;
    border-top: 1px solid var(--paper-line);
  }

  .mini-ranking__total {
    color: var(--ink);
    font-family: var(--font-latin);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mini-ranking__row:nth-child(2) .mini-ranking__rank {
    color: var(--sky-text);
  }

  .mini-ranking__row:nth-child(3) .mini-ranking__rank {
    color: var(--flare-text);
  }


  .mini-ranking__foot {
    align-items: center;
    border-top: 1px solid var(--paper-line);
  }

  .mini-ranking__cut {
    color: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.05em;
  }

  /* =========================================================
     Schedule preview
     ========================================================= */

  .schedule-preview {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(25rem, 1.18fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .schedule-preview__lead h2 {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 1.8rem + 6vw, 8.5rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .schedule-preview__lead > p:not(.eyebrow) {
    max-width: 31rem;
    margin-top: 1.3rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .schedule-date {
    display: grid;
    max-width: 24rem;
    margin-top: 2rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .schedule-date__label {
    color: var(--paper-muted);
    font-size: 0.55rem;
  }

  .schedule-date__value {
    margin-top: 0.4rem;
    font-size: clamp(4rem, 7vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .schedule-date__cn {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .schedule-date__venue {
    margin-top: 0.3rem;
    color: var(--paper-muted);
    font-size: var(--text-xs);
  }

  .schedule-preview__lead .link-arrow {
    margin-top: 1.4rem;
  }

  .schedule-preview__list {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .schedule-preview__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    color: var(--paper-muted);
    border-bottom: 1px solid var(--paper-line);
  }

  .schedule-preview__head .mono {
    font-size: 0.52rem;
  }

  .schedule-preview__list ol {
    list-style: none;
  }

  .schedule-preview__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto 1.5rem;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .schedule-preview__code {
    color: var(--flare-text);
    font-size: 0.58rem;
  }

  .schedule-preview__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .schedule-preview__time {
    color: var(--paper-muted);
    font-size: 0.55rem;
  }

  .schedule-preview__arrow {
    color: var(--paper-muted);
    font-size: 1rem;
    text-align: right;
  }

  .schedule-preview__note {
    padding: 0.9rem 0 1rem;
    color: var(--paper-muted);
    font-size: var(--text-2xs);
    line-height: 1.7;
  }

  /* =========================================================
     Outro
     ========================================================= */

  .home-outro {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--ink);
    background: var(--flare);
    color: var(--ink);
  }

  .home-outro__inner {
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .home-outro .eyebrow {
    color: rgba(23, 24, 17, 0.82);
  }

  .home-outro h2 {
    max-width: 14ch;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.6rem + 6vw, 8rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  .home-outro__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: 1.2rem;
    border-top: 1px solid rgba(23, 24, 17, 0.4);
  }

  .home-outro__foot p {
    max-width: 30rem;
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  /* =========================================================
     Responsive
     ========================================================= */

  @media (max-width: 1100px) {
    .home-hero__body {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.68fr);
      gap: 2.5rem;
    }

    .home-hero__meta {
      grid-template-columns: 1fr 1fr;
    }

    .home-hero__meta > div + div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .home-hero__meta > div:nth-child(n + 3) {
      border-top: 1px solid var(--ink-line);
    }

    .ranking-preview,
    .schedule-preview {
      gap: 4rem;
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      min-height: 0;
    }

    .home-hero__inner {
      min-height: 0;
    }

    .home-hero__decor {
      top: 8rem;
    }

    .home-hero__body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .home-hero__visual {
      justify-content: flex-start;
      margin-top: 0;
      margin-bottom: 1.5rem;
      padding-top: 0;
    }

    .home-hero__copy {
      padding-bottom: 0;
    }

    .hero-news {
      max-width: 44rem;
    }

    .flow-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .flow-copy {
      padding-top: 0;
    }

    .flow-strip {
      grid-template-columns: 1fr 1fr;
    }

    .flow-stage:nth-child(odd) {
      border-left: 0;
    }

    .flow-stage:nth-child(n + 3) {
      border-top: 1px solid var(--paper-line);
    }

    .ranking-preview,
    .schedule-preview {
      grid-template-columns: 1fr;
    }

    .mini-ranking {
      max-width: 38rem;
    }

    .schedule-date {
      max-width: 28rem;
    }
  }

  @media (max-width: 640px) {
    .home-hero__decor {
      display: none;
    }

    .home-hero__top {
      align-items: flex-start;
    }

    .home-hero__top-meta .mono {
      display: none;
    }

    .home-hero__status {
      padding-top: 0.15rem;
      font-size: 0.55rem;
    }

    .home-hero__city {
      gap: 0.75rem;
      font-size: 1.65rem;
    }

    .home-hero__city-en {
      font-size: 0.5rem;
    }

    .home-hero__first-line {
      margin-top: 1.5rem;
      margin-left: 0;
      font-size: clamp(3.4rem, 15.5vw, 6.5rem);
      text-indent: -0.22em;
    }

    .home-hero__last-line {
      margin-top: 1.75rem;
      margin-left: 0;
      font-size: clamp(3rem, 12.5vw, 6rem);
    }

    .home-hero__visual {

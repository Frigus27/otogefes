<script>
  import { loadRankingBoard } from '../lib/ranking-client';
  import { rankingSignature } from '../lib/ranking';
  import { formatDateTime, formatScore, padNumber } from '../lib/format';
  import { RANKING_ENDPOINT, RANKING_REFRESH_MS } from '../config/ranking';

  const root = document.querySelector<HTMLElement>('[data-home-ranking]');

  if (root) {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-home-ranking-row]'));
    const updated = document.querySelector<HTMLElement>('[data-home-updated]');
    const cut = document.querySelector<HTMLElement>('[data-home-cut]');
    const status = document.querySelector<HTMLElement>('[data-home-status] .status');
    const notice = document.querySelector<HTMLElement>('[data-home-notice]');
    let inFlight = false;
    let lastSignature = '';

    const refresh = async () => {
      if (inFlight || document.hidden) return;
      inFlight = true;

      try {
        const board = await loadRankingBoard(root.dataset.rankingEndpoint || RANKING_ENDPOINT);
        const signature = rankingSignature(board);
        if (signature === lastSignature) return;
        lastSignature = signature;

        const topEntries = board.entries.slice(0, rows.length);

        rows.forEach((row, index) => {
          const entry = topEntries[index];
          row.hidden = !entry;
          if (!entry) return;

          const rank = row.querySelector<HTMLElement>('[data-home-rank]');
          const name = row.querySelector<HTMLElement>('[data-home-name]');
          const id = row.querySelector<HTMLElement>('[data-home-id]');
          const scores = row.querySelector<HTMLElement>('[data-home-scores]');
          const total = row.querySelector<HTMLElement>('[data-home-total]');
          const video = row.querySelector<HTMLAnchorElement>('[data-home-video]');

          if (rank) rank.textContent = padNumber(entry.rank);
          if (name) name.textContent = entry.playerName;
          if (id) id.textContent = entry.playerId;
          if (scores) scores.setAttribute('aria-label', `${entry.playerName} 的总分与三曲成绩`);
          if (total) total.textContent = formatScore(entry.total);

          entry.scores.forEach((score, scoreIndex) => {
            const target = row.querySelector<HTMLElement>(`[data-home-score="${scoreIndex}"]`);
            if (target) target.textContent = formatScore(score);
          });

          if (video) {
            video.href = entry.videoUrl;
            video.hidden = !entry.videoUrl;
            video.setAttribute('aria-label', `查看 ${entry.playerName} 的手元或屏元`);
          }
        });

        if (updated) {
          updated.textContent = `UPDATED ${formatDateTime(new Date(board.updatedAt))}`;
        }
        if (cut) {
          cut.textContent = `直通线 / TOP ${padNumber(board.cutoff)} · LCQ ${padNumber(board.lcqCutoff)}`;
        }

        if (status) {
          status.className = `status status--${board.statusTone}`;
          status.textContent = board.statusLabel;
        }

        if (notice) {
          notice.textContent = board.notice;
        }

        root.dataset.rankingVersion = board.updatedAt;
      } catch (error) {
        console.warn('[ranking] 首页榜单预览同步失败：', error);
      } finally {
        inFlight = false;
      }
    };

    void refresh();

    window.setInterval(() => {
      void refresh();
    }, RANKING_REFRESH_MS);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refresh();
    });
  }
</script>

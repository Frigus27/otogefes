---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RankingTable from '../components/RankingTable.astro';
import RankingExample from '../components/RankingExample.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { ranking, SCORE_COUNT } from '../data/ranking';
import { RANKING_ENDPOINT, SHOW_RANKING_BANNER } from '../config/ranking';
import { withBase } from '../lib/url';
import { formatDateTime, padNumber } from '../lib/format';

const lastUpdated = formatDateTime(new Date(ranking.updatedAt));
const entryCount = ranking.entries.length;
// 用 glob 引用可选的曲绘资源：文件不存在时返回空对象，
// 关闭横幅（默认）或无授权素材时都能正常构建。
const bannerModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/banners/banner-ranking-songs.png',
  { eager: true },
);
const bannerSongs = SHOW_RANKING_BANNER ? (Object.values(bannerModules)[0]?.default ?? null) : null;
---

<BaseLayout
  title="预选榜单"
  description="合肥「第一」音游祭 Arcaea 项目预选榜单展示页。实时展示名次、选手名称与 id、三曲成绩、手元或屏元链接、收录时间与晋级状态。"
>
  <PageHero
    index="02"
    kicker="ONLINE QUALIFIER / RANKING"
    title="预选榜单"
    englishTitle="QUALIFIER RANKING"
    description="线上预选阶段的有效成绩将在这里统一汇总。榜单按三曲总分与收录时间生成排名，并展示手元或屏元、审核状态与晋级结果。"
    status={{ label: ranking.statusLabel, tone: ranking.statusTone }}
    accent="sky"
  >
    <dl class="hero-facts">
      <div>
        <dt class="mono">PROJECT</dt>
        <dd>{ranking.project}</dd>
      </div>
      <div>
        <dt class="mono">ENTRIES</dt>
        <dd data-live-count>{padNumber(entryCount)} / 正式</dd>
      </div>
      <div>
        <dt class="mono">CUT LINE</dt>
        <dd data-live-cutoff>直通 TOP {padNumber(ranking.cutoff)} · LCQ {padNumber(ranking.lcqCutoff)}</dd>
      </div>
    </dl>
  </PageHero>

  <div
    class="ranking-bar"
    data-ranking-live
    data-ranking-endpoint={RANKING_ENDPOINT}
    data-ranking-version={ranking.updatedAt}
  >
    <div class="container ranking-bar__inner">
      <div class="ranking-bar__item">
        <span class="mono">STATUS / 状态</span>
        <StatusBadge label={ranking.statusLabel} tone={ranking.statusTone} />
      </div>
      <div class="ranking-bar__item">
        <span class="mono">LAST UPDATED / 最后更新</span>
        <time datetime={ranking.updatedAt} data-live-updated>{lastUpdated}</time>
      </div>
      <div class="ranking-bar__item">
        <span class="mono">MODE / 数据模式</span>
        <span class="ranking-bar__mode" data-live-mode>正式榜单 / LIVE</span>
        <span class="ranking-bar__sync" data-live-sync>构建快照 · 等待实时同步</span>
      </div>
      <a class="ranking-bar__link mono" href={withBase(ranking.rulesHref)} data-live-rules>
        排名规则
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  {
    SHOW_RANKING_BANNER && bannerSongs && (
      <div class="ranking-banner" aria-hidden="true">
        <Image
          src={bannerSongs}
          alt=""
          widths={[768, 1152, 1536, 2048, 3072]}
          sizes="(max-width: 520px) 227vw, (max-width: 1633px) 1600px, 100vw"
          format="webp"
          quality={82}
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }

  <section class="ranking-main section" aria-labelledby="ranking-heading">
    <div class="container">
      <div class="ranking-heading" data-reveal>
        <div>
          <p class="eyebrow">QUALIFIER STANDINGS</p>
          <h2 id="ranking-heading">有效成绩排行</h2>
        </div>
        <div class="ranking-heading__meta">
          <p class="mono">SCORES / {SCORE_COUNT} TRACKS</p>
          <p class="mono" data-live-cutoff-meta>CUT / TOP {padNumber(ranking.cutoff)} · LCQ {padNumber(ranking.lcqCutoff)}</p>
        </div>
      </div>

      <div data-reveal>
        <RankingTable
          board={ranking}
          emptyText="线上预选尚未产生有效成绩。正式榜单开放后，这里会自动展示名次、选手、三曲成绩、时间与晋级状态。"
        />
      </div>

      {
        ranking.example && (
          <div data-reveal>
            <RankingExample example={ranking.example} songs={ranking.songs} />
          </div>
        )
      }

      <div class="ranking-after" data-reveal>
        <div class="ranking-after__note">
          <p class="mono">ABOUT THIS TABLE / 关于本表</p>
          <p>
            晋级线依据正式章程：第 1—7 名直通正赛，第 8—15 名进入 LCQ。成绩字段、同分排序与审核状态以章程及统一公告为准。
          </p>
        </div>
        <a class="rules-link" href={withBase(ranking.rulesHref)}>
          <span class="mono">RULE REFERENCE</span>
          <span class="rules-link__title">了解排名与晋级规则</span>
          <span class="rules-link__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink-line);
  }

  .hero-facts dt {
    color: var(--ink-muted);
    font-size: 0.5rem;
  }

  .hero-facts dd {
    margin-top: 0.3rem;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .ranking-bar {
    border-bottom: 1px solid var(--paper-line);
    background: var(--paper-raised);
  }

  .ranking-bar__inner {
    display: grid;
    grid-template-columns: auto auto auto 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .ranking-bar__item {
    display: grid;
    gap: 0.25rem;
    padding-right: 2.5rem;
    border-right: 1px solid var(--paper-line);
  }

  .ranking-bar__item .mono {
    color: var(--paper-muted);
    font-size: 0.48rem;
  }

  .ranking-bar__item time,
  .ranking-bar__mode {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .ranking-bar__mode {
    color: var(--flare-text);
  }

  .ranking-bar__sync {
    color: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .ranking-bar__sync.is-error {
    color: var(--flare-text);
  }

  .ranking-bar__link {
    justify-self: end;
    color: var(--ink);
    font-size: 0.58rem;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  .ranking-bar__link:hover {
    background: var(--cream);
  }

  .ranking-banner {
    /* Height is capped between "fit the full 4644px art" and "fit the
       central 2048px core", so the three jackets are never cropped. */
    --banner-height: clamp(260px, 25vw, 360px);
    position: relative;
    overflow: hidden;
    height: clamp(calc(100vw / 4.5352), var(--banner-height), calc(100vw / 2));
    border-bottom: 1px solid var(--paper-line);
    background: var(--paper-deep);
  }

  .ranking-banner img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .ranking-main {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .ranking-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .ranking-heading h2 {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.045em;
  }

  .ranking-heading__meta {
    display: grid;
    gap: 0.25rem;
    color: var(--paper-muted);
    text-align: right;
  }

  .ranking-heading__meta .mono {
    font-size: 0.5rem;
  }

  .ranking-after {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.45fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: stretch;
    margin-top: 2rem;
  }

  .ranking-after__note {
    display: grid;
    align-content: start;
    gap: 0.7rem;
  }

  .ranking-after__note .mono {
    color: var(--paper-muted);
    font-size: 0.5rem;
  }

  .ranking-after__note p:last-child {
    max-width: 50rem;
    color: var(--paper-muted);
    font-size: var(--text-xs);
    line-height: 1.8;
  }

  .rules-link {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.45rem;
    min-height: 9rem;
    padding: 1.25rem;
    border: 1px solid var(--ink);
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-snap),
      box-shadow var(--dur-fast) var(--ease-snap),
      transform var(--dur-fast) var(--ease-snap);
  }

  .rules-link:hover {
    background: var(--cream);
    box-shadow: 4px 4px 0 var(--cream-deep);
    transform: translate(-2px, -2px);
  }

  .rules-link .mono {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    color: var(--paper-muted);
    font-size: 0.5rem;
  }

  .rules-link__title {
    padding-right: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.65rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .rules-link__arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1.15rem;
    font-size: 1.4rem;
  }

  .explainer-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .explainer-head h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .explainer-head > p {
    max-width: 39rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .explainer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .explainer-grid > div {
    padding: 1.3rem 1.4rem 1.6rem 0;
  }

  .explainer-grid > div + div {
    padding-left: 1.4rem;
    border-left: 1px solid var(--paper-line);
  }

  .explainer-grid dt {
    display: flex;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .explainer-grid dt .mono {
    padding-top: 0.22rem;
    color: var(--flare-text);
    font-size: 0.52rem;
  }

  .explainer-grid dd {
    margin-top: 0.8rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .ranking-endnote {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .ranking-endnote .mono {
    color: var(--paper-muted);
    font-size: 0.5rem;
  }

  .ranking-endnote > p:nth-child(2) {
    max-width: 44rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  @media (max-width: 960px) {
    .ranking-bar__inner {
      grid-template-columns: 1fr 1fr;
      gap: 1rem 2rem;
    }

    .ranking-bar__item {
      padding-right: 0;
      border-right: 0;
    }

    .ranking-bar__link {
      justify-self: start;
    }

    .ranking-after {
      grid-template-columns: 1fr;
    }

    .rules-link {
      min-height: 8rem;
    }

    .explainer-head {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .ranking-endnote {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 700px) {
    .hero-facts {
      gap: 0.6rem;
    }

    .hero-facts dd {
      font-size: 0.63rem;
    }

    .ranking-bar__inner {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .ranking-bar__item {
      grid-template-columns: 8.5rem 1fr;
      align-items: center;
      gap: 0.3rem 1rem;
    }

    .ranking-bar__sync {
      grid-column: 2;
    }

    .ranking-heading {
      display: grid;
      gap: 0.8rem;
    }

    .ranking-heading__meta {
      text-align: left;
    }

    .explainer-grid {
      grid-template-columns: 1fr;
    }

    .explainer-grid > div + div {
      padding-left: 0;
      border-top: 1px solid var(--paper-line);
      border-left: 0;
    }
  }
</style>

<script>
  import type { RankingBoard } from '../lib/ranking';
  import { rankingSignature } from '../lib/ranking';
  import { loadRankingBoard } from '../lib/ranking-client';
  import { renderRankingTable } from '../lib/ranking-render';
  import { withBase } from '../lib/url';
  import { formatDateTime, formatRankingTime, padNumber } from '../lib/format';
  import { RANKING_ENDPOINT, RANKING_REFRESH_MS } from '../config/ranking';

  const root = document.querySelector<HTMLElement>('[data-ranking-live]');

  if (root) {
    const endpoint = root.dataset.rankingEndpoint || RANKING_ENDPOINT;
    const tableHost = document.querySelector<HTMLElement>('[data-ranking-table]');
    const sync = document.querySelector<HTMLElement>('[data-live-sync]');
    const lastUpdated = document.querySelector<HTMLTimeElement>('[data-live-updated]');
    const count = document.querySelector<HTMLElement>('[data-live-count]');
    const cutoff = document.querySelector<HTMLElement>('[data-live-cutoff]');
    const cutoffMeta = document.querySelector<HTMLElement>('[data-live-cutoff-meta]');
    const notice = document.querySelector<HTMLElement>('[data-live-notice]');
    const rulesLink = document.querySelector<HTMLAnchorElement>('[data-live-rules]');
    const statusBadges = document.querySelectorAll<HTMLElement>('.page-hero .status, .ranking-bar .status');

    const emptyText =
      '线上预选尚未产生有效成绩。正式榜单开放后，这里会自动展示名次、选手、三曲成绩、时间与晋级状态。';

    let lastSignature = '';
    let inFlight = false;
    let syncText = '';

    const setSync = (text: string, isError = false) => {
      if (!sync || text === syncText) return;
      syncText = text;
      sync.textContent = text;
      sync.classList.toggle('is-error', isError);
    };

    const updateStatusBadges = (board: RankingBoard) => {
      statusBadges.forEach((badge) => {
        badge.className = `status status--${board.statusTone}`;
        badge.textContent = board.statusLabel;
      });
    };

    const updateMeta = (board: RankingBoard) => {
      updateStatusBadges(board);

      if (lastUpdated) {
        lastUpdated.dateTime = board.updatedAt;
        lastUpdated.textContent = formatDateTime(new Date(board.updatedAt));
      }

      if (count) {
        count.textContent = `${padNumber(board.entries.length)} / 正式`;
      }

      if (cutoff) {
        cutoff.textContent = `直通 TOP ${padNumber(board.cutoff)} · LCQ ${padNumber(board.lcqCutoff)}`;
      }

      if (cutoffMeta) {
        cutoffMeta.textContent = `CUT / TOP ${padNumber(board.cutoff)} · LCQ ${padNumber(board.lcqCutoff)}`;
      }

      if (notice) {
        notice.textContent = board.notice;
      }

      if (rulesLink) {
        rulesLink.href = withBase(board.rulesHref);
      }
    };

    const refresh = async () => {
      if (inFlight || document.hidden) return;
      inFlight = true;

      try {
        const board = await loadRankingBoard(endpoint);
        const signature = rankingSignature(board);
        const changed = signature !== lastSignature;

        if (changed && tableHost) {
          tableHost.innerHTML = renderRankingTable(board, emptyText);
          lastSignature = signature;
          root.dataset.rankingVersion = board.updatedAt;
        }

        updateMeta(board);
        setSync(`已同步 ${formatRankingTime(board.updatedAt)}`);
      } catch (error) {
        setSync('实时数据不可用 · 显示构建快照', true);
        console.warn('[ranking] 实时榜单加载失败：', error);
      } finally {
        inFlight = false;
      }
    };

    void refresh();

    window.setInterval(() => {
      void refresh();
    }, RANKING_REFRESH_MS);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refresh();
    });

    window.addEventListener('pageshow', () => {
      void refresh();
    });
  }
</script>

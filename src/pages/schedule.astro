---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ScheduleTimeline from '../components/ScheduleTimeline.astro';
import ScheduleSlots from '../components/ScheduleSlots.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { schedule } from '../data/schedule';
import { event } from '../config/event';
import { validateScheduleData } from '../lib/validate';
import { withBase } from '../lib/url';

validateScheduleData(schedule);

const extensions = [
  {
    id: 'qualifiers',
    code: 'Q',
    title: '直通与 LCQ 名单',
    data: schedule.qualifiers,
    description: '预选结束后公布直通正赛的第 1—7 名、进入 LCQ 的第 8—15 名与候补顺序。',
  },
  {
    id: 'bracket',
    code: 'B',
    title: '八强对阵',
    data: schedule.bracket,
    description: '第 1—4 号与第 5—8 号种子公开抽签形成 U1—U4，抽签后固定整张双败赛程。',
  },
  {
    id: 'results',
    code: 'R',
    title: '比赛结果',
    data: schedule.results,
    description: '比赛日结束后公布冠军、亚军、季军及各场比分记录。',
  },
];
---

<BaseLayout
  title="现场赛程"
  description="合肥「第一」音游祭 Arcaea 现场赛程：线下比赛拟于 2027 年 1 月 1 日举行，当天进行 LCQ 与八强双败正赛，共九个时段。场馆与具体时刻待公布。"
>
  <PageHero
    index="04"
    kicker="ON-SITE / SCHEDULE"
    title="现场赛程"
    englishTitle="LIVE SCHEDULE"
    description="线下比赛拟于 2027 年 1 月 1 日在待定场馆举行。当天先进行 LCQ，随后按九个时段完成八强双败正赛与颁奖；签到与开赛时刻待公布。"
    status={{ label: schedule.statusLabel, tone: schedule.statusTone }}
    accent="flare"
  >
    <dl class="schedule-hero-meta">
      <div>
        <dt class="mono">DATE / 日期</dt>
        <dd>{schedule.dateLabel}</dd>
      </div>
      <div>
        <dt class="mono">VENUE / 场馆</dt>
        <dd>合肥 · {schedule.venueName}</dd>
      </div>
      <div>
        <dt class="mono">FORMAT / 形式</dt>
        <dd>LCQ + 八强双败</dd>
      </div>
    </dl>
  </PageHero>

  <div class="schedule-alert">
    <div class="container schedule-alert__inner">
      <span class="schedule-alert__badge mono">CHARTER V3.4 / 章程同步</span>
      <p><strong>赛制已确定。</strong>{schedule.notice}</p>
      <a class="mono" href={withBase('/rules')}>查看比赛章程 <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <section class="venue-section section section--dark" aria-labelledby="venue-title">
    <div class="container venue-grid">
      <div class="venue-copy" data-reveal>
        <p class="eyebrow">VENUE / 场地</p>
        <h2 id="venue-title">
          <span class="venue-copy__city">{event.venue.city}</span>
          <span style="visibility: hidden;">1</span>
          <span class="venue-copy__status">场馆待公布</span>
        </h2>
        <p class="venue-copy__lead">
          线下比赛拟于 2027 年 1 月 1 日在待定场馆举行。场馆名称、详细地址、交通方式、入校与观赛安排将在确认后统一发布。
        </p>
        <p class="venue-copy__note">{schedule.venueNote}</p>

        <dl class="venue-facts">
          <div>
            <dt class="mono">DATE / 日期</dt>
            <dd>{schedule.dateLabel}</dd>
          </div>
          <div>
            <dt class="mono">VENUE / 场馆</dt>
            <dd>{schedule.venueName}</dd>
          </div>
          <div>
            <dt class="mono">FORMAT / 形式</dt>
            <dd>LCQ + 八强双败</dd>
          </div>
          <div>
            <dt class="mono">STAGE / 舞台</dt>
            <dd>前期双舞台 → 单线</dd>
          </div>
        </dl>
      </div>

      <div class="venue-graphic" data-reveal style="--reveal-delay: 120ms;" aria-hidden="true">
        <div class="venue-graphic__top">
          <span class="mono">SCHEMATIC / 非真实地图</span>
          <span class="mono">HF / 01</span>
        </div>
        <svg viewBox="0 0 560 460" class="venue-graphic__svg" focusable="false">
          <defs>
            <pattern id="venue-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="560" height="460" fill="url(#venue-grid)" opacity="0.36" />
          <path
            d="M-30 380C80 330 120 240 220 240s125 78 190 36 90-158 180-172"
            fill="none"
            stroke="rgba(243,240,230,.18)"
            stroke-width="26"
          />
          <path
            d="M60 -20C92 90 180 120 210 190s10 154 86 196 176 62 230 116"
            fill="none"
            stroke="rgba(243,240,230,.12)"
            stroke-width="10"
          />
          <path d="M0 230H560M280 0V460" stroke="rgba(243,240,230,.16)" stroke-dasharray="3 8" />
          <circle cx="280" cy="230" r="74" fill="none" stroke="rgba(243,240,230,.35)" />
          <circle cx="280" cy="230" r="36" fill="none" stroke="var(--signal)" />
          <circle cx="280" cy="230" r="5" fill="var(--signal)" />
          <path d="M280 128V88M280 372V332M178 230H138M422 230H382" stroke="rgba(243,240,230,.5)" />
          <text x="280" y="248" text-anchor="middle" class="venue-graphic__pin-text">TBD</text>
          <text x="36" y="428" class="venue-graphic__label">HEFEI / ANHUI / CN</text>
          <text x="524" y="428" text-anchor="end" class="venue-graphic__label">VENUE NOT CONFIRMED</text>
        </svg>
        <div class="venue-graphic__bottom">
          <span class="mono">LOCATION DATA PENDING</span>
          <span class="venue-graphic__cross" aria-hidden="true">+</span>
        </div>
      </div>
    </div>
  </section>

  <section class="schedule-main section" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="schedule-head" data-reveal>
        <div>
          <p class="eyebrow">RUN OF SHOW / 比赛日</p>
          <h2 id="schedule-heading">比赛日结构</h2>
        </div>
        <p>
          比赛日先进行 LCQ 分组轮与决胜轮，随后进入八强双败正赛。正赛前期主、副舞台并行，L3、L4 完成后转为单线；签到与开赛时刻待公布。
        </p>
      </div>

      <ol class="phase-strip" role="list" data-reveal>
        {
          schedule.overview.map((item, index) => (
            <li>
              <span class="phase-strip__code mono">0{index + 1}</span>
              <span class="phase-strip__label">{item.label}</span>
              <StatusBadge label={item.value} tone={item.tone} />
            </li>
          ))
        }
      </ol>

      <div class="schedule-timeline-wrap" data-reveal>
        <div class="timeline-head">
          <span class="mono">TIME / 阶段</span>
          <span class="mono">STATUS / 时刻待公布</span>
        </div>
        <ScheduleTimeline items={schedule.items} />
      </div>
    </div>
  </section>

  <section class="slots-section section section--dark section--tight" aria-labelledby="slots-heading">
    <div class="container">
      <div class="slots-head" data-reveal>
        <div>
          <p class="eyebrow">SLOT FLOW / 时段流向</p>
          <h2 id="slots-heading">九个时段排程</h2>
        </div>
        <p>
          比赛日按九个时段推进：前五个时段主、副舞台并行，时段 6 起转为单线；每一时段须待其依赖场次完成、成绩确认且选手获得规定休息后开始。
        </p>
      </div>

      <div data-reveal style="--reveal-delay: 80ms;">
        <ScheduleSlots slots={schedule.slots} />

        <p class="slots-foot mono">TIME TBD / 各时段时刻与最低休息安排待现场时间表公布</p>
      </div>
    </div>
  </section>

  <section class="schedule-extensions section section--paper-deep" aria-labelledby="extensions-heading">
    <div class="container">
      <SectionHeading
        index="04.1"
        eyebrow="AFTER THE QUALIFIER"
        title="直通、对阵与结果"
        id="extensions-heading"
        intro="名单在对阵抽签与成绩审核完成后更新。当前没有可公布的直通、LCQ、对阵或结果信息。"
      >
        <StatusBadge label="全部待公布" tone="upcoming" />
      </SectionHeading>

      <div class="extension-grid">
        {
          extensions.map((item, index) => (
            <article id={item.id} class="extension-card" data-reveal style={`--reveal-delay: ${index * 80}ms;`}>
              <div class="extension-card__head">
                <span class="extension-card__code latin">{item.code}</span>
                <StatusBadge label={item.data.published ? '已公布' : '待公布'} tone={item.data.published ? 'done' : 'upcoming'} />
              </div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="extension-card__empty">
                <span class="mono">PUBLISH PENDING / 待公布</span>
                <p>{item.data.emptyText}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="extensions-note">
        <p class="mono">PUBLICATION / 发布说明</p>
        <p>
          直通与 LCQ 名单在预选成绩审核后公布；对阵在公开抽签后公布；比赛结果在比赛日结束后公布。所有内容以统一公告为准，<a href={withBase('/rules#ranking-advance')}>查看晋级规则 →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="schedule-cta section section--signal" aria-labelledby="schedule-cta-title">
    <div class="container schedule-cta__inner">
      <div>
        <p class="eyebrow">SAVE THE DATE / 比赛日</p>
        <h2 id="schedule-cta-title">2027.1.1，<br />现场见。</h2>
      </div>
      <div class="schedule-cta__side">
        <p>
          比赛日与赛制已写入正式章程，场馆、签到与开赛时刻仍在确认。请以赛事公告中的最终信息为准，不要依据非官方来源安排行程。
        </p>
        <div class="schedule-cta__actions">
          <a class="btn btn--cream" href={withBase('/news')}>
            查看赛事公告
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="btn" href={withBase('/rules')}>
            阅读比赛章程
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule-hero-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    padding-top: 1rem;
    border-top: 1px solid var(--ink-line);
  }

  .schedule-hero-meta dt {
    color: var(--ink-muted);
    font-size: 0.5rem;
  }

  .schedule-hero-meta dd {
    margin-top: 0.25rem;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .schedule-alert {
    border-bottom: 1px solid var(--paper-line);
    background: var(--paper-raised);
  }

  .schedule-alert__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.5rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .schedule-alert__badge {
    flex: none;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--flare-text);
    color: var(--flare-text);
    font-size: 0.55rem;
  }

  .schedule-alert__inner p {
    flex: 1 1 30rem;
    color: var(--paper-muted);
    font-size: var(--text-xs);
    line-height: 1.7;
  }

  .schedule-alert__inner p strong {
    color: var(--ink);
  }

  .schedule-alert__inner > a {
    color: var(--ink);
    font-size: 0.55rem;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  .schedule-alert__inner > a:hover {
    background: var(--cream);
  }

  .venue-section {
    overflow: hidden;
  }

  .venue-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.8fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
  }

  .venue-copy h2 {
    display: grid;
    margin-top: 1.5rem;
  }

  .venue-copy__city {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 2.7rem + 7vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .venue-copy__status {
    margin-top: 0.7rem;
    color: var(--flare);
    font-family: var(--font-sans);
    font-size: clamp(0.85rem, 0.75rem + 0.3vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .venue-copy__lead {
    max-width: 36rem;
    margin-top: 1.7rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    font-size: var(--text-base);
    line-height: 1.9;
  }

  .venue-copy__note {
    max-width: 34rem;
    margin-top: 0.8rem;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    line-height: 1.8;
  }

  .venue-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 2rem;
    border-top: 1px solid var(--ink-line);
  }

  .venue-facts > div {
    padding: 0.8rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--ink-line);
  }

  .venue-facts > div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--ink-line);
  }

  .venue-facts dt {
    color: var(--ink-muted);
    font-size: 0.5rem;
  }

  .venue-facts dd {
    margin-top: 0.3rem;
    color: var(--paper);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .venue-graphic {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ink-line);
    background: var(--ink-raised);
  }

  .venue-graphic::after {
    position: absolute;
    top: 0;
    left: 1.2rem;
    width: 3.5rem;
    height: 3px;
    background: var(--flare);
    content: "";
  }

  .venue-graphic__top,
  .venue-graphic__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    color: var(--ink-muted);
  }

  .venue-graphic__top .mono,
  .venue-graphic__bottom .mono {
    font-size: 0.48rem;
  }

  .venue-graphic__svg {
    width: 100%;
    color: rgba(243, 240, 230, 0.15);
  }

  .venue-graphic__pin-text {
    fill: var(--signal);
    font-family: var(--font-latin);
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .venue-graphic__label {
    fill: rgba(243, 240, 230, 0.45);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1.4px;
  }

  .venue-graphic__bottom {
    align-items: center;
    border-top: 1px solid var(--ink-line);
  }

  .venue-graphic__cross {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    line-height: 1;
  }

  .schedule-head {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(20rem, 1.25fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .schedule-head h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .schedule-head > p {
    max-width: 40rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .phase-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    list-style: none;
  }

  .phase-strip li {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.2rem 1.1rem 0;
  }

  .phase-strip li + li {
    padding-left: 1.2rem;
    border-left: 1px solid var(--paper-line);
  }

  .phase-strip__code {
    color: var(--flare-text);
    font-size: 0.55rem;
  }

  .phase-strip__label {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.95rem + 0.5vw, 1.4rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .phase-strip .status {
    justify-self: start;
  }

  .schedule-timeline-wrap {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .timeline-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--paper-line);
    color: var(--paper-muted);
  }

  .timeline-head .mono {
    font-size: 0.5rem;
  }

  .slots-head {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(20rem, 1.25fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
  }

  .slots-head h2 {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.4rem + 2.8vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .slots-head > p {
    max-width: 40rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .slots-foot {
    margin-top: 1.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--ink-line);
    color: var(--fg-muted);
    font-size: 0.5rem;
    line-height: 1.7;
  }

  .schedule-extensions {
    position: relative;
  }

  .extension-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--ink);
  }

  .extension-card {
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    padding: 1.25rem 1.4rem 1.4rem 0;
    border-bottom: 1px solid var(--ink);
  }

  .extension-card + .extension-card {
    padding-left: 1.4rem;
    border-left: 1px solid var(--paper-line);
  }

  .extension-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .extension-card__code {
    color: var(--flare-text);
    font-size: 2.3rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .extension-card h3 {
    margin-top: 1.8rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.15rem + 0.7vw, 1.8rem);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .extension-card > p {
    margin-top: 0.55rem;
    color: var(--paper-muted);
    font-size: var(--text-xs);
    line-height: 1.75;
  }

  .extension-card__empty {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .extension-card__empty .mono {
    color: var(--paper-muted);
    font-size: 0.48rem;
  }

  .extension-card__empty p {
    padding: 0.8rem 0.9rem;
    border: 1px dashed var(--paper-muted);
    color: var(--paper-muted);
    font-size: var(--text-xs);
    line-height: 1.65;
  }

  .extensions-note {
    display: grid;
    grid-template-columns: minmax(10rem, 0.28fr) minmax(0, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .extensions-note .mono {
    color: var(--paper-muted);
    font-size: 0.5rem;
  }

  .extensions-note p:last-child {
    max-width: 48rem;
    color: var(--paper-muted);
    font-size: var(--text-xs);
    line-height: 1.8;
  }

  .extensions-note a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    white-space: nowrap;
  }

  .extensions-note a:hover {
    background: var(--cream);
  }

  .schedule-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.72fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: end;
  }

  .schedule-cta .eyebrow {
    color: var(--paper-muted);
  }

  .schedule-cta h2 {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.4rem + 3.8vw, 5.2rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .schedule-cta__side > p {
    max-width: 31rem;
    color: var(--paper-muted);
    font-size: var(--text-sm);
